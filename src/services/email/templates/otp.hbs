{{#> layout emailTitle="Mã xác thực OTP"}}
  <h2 style="margin:0 0 16px;color:#111827;font-size:22px;font-weight:700;">Mã xác thực của bạn</h2>
  <p style="margin:0 0 24px;color:#374151;font-size:15px;line-height:1.6;">
    Xin chào {{userName}},<br>
    Bạn đang thực hiện xác thực trên {{siteName}}. Vui lòng nhập mã OTP bên dưới để hoàn tất thao tác.
  </p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;border-radius:8px;margin-bottom:24px;">
    <tr>
      <td align="center" style="padding:24px;">
        <span style="font-size:32px;font-weight:700;letter-spacing:8px;color:#111827;">{{otpCode}}</span>
      </td>
    </tr>
  </table>
  <p style="margin:0;color:#6b7280;font-size:13px;line-height:1.6;">
    Mã OTP hết hạn sau <strong>{{expiryMinutes}} phút</strong>. Không chia sẻ mã này với bất kỳ ai.
  </p>
{{/layout}}
