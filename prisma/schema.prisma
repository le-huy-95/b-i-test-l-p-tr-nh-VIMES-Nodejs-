generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  suspended
}

enum TenantRole {
  admin
  warehouse_keeper
  accountant
  staff
}

enum ContactKind {
  internal
  external
}

enum ContactRelationType {
  delivery_person
  vendor_contact
  receiver
  other
}

enum CostingMethod {
  fifo
  weighted_average
  specific_identification
}

enum PickingPriority {
  fefo
  fifo
  none
}

enum ReceiptType {
  purchase
  customer_return
  transfer_in
  production_output
  other
}

enum GeoSource {
  manual
  geocoded
}

enum GeocodeStatus {
  pending
  success
  failed
  not_applicable
}

enum DocStatus {
  draft
  pending_approval
  approved
  completed
  rejected
  cancelled
}

enum IssueType {
  sale
  internal_use
  return_to_supplier
  disposal
}

enum DocumentType {
  stock_issue
  stock_receipt
  stock_opening
}

enum WorkflowStepStatus {
  pending
  approved
  rejected
  signed_by_proxy
  skipped
  cancelled
}

enum WorkflowDocumentStatus {
  draft
  in_review
  approved
  rejected
  cancelled
  completed
}

enum LedgerTxnType {
  opening
  in
  out
  transfer_in
  transfer_out
  adjust
  transfer_cancel_return
}

enum ReservationStatus {
  active
  released
  consumed
  expired
}

enum EmailLogStatus {
  pending
  success
  failed
}

enum IdempotencyStatus {
  in_progress
  completed
  failed
}

enum AuditAction {
  create
  update
  delete
  submit
  approve
  reject
  complete
  cancel
  post
  invite
  accept
}

enum DeviceType {
  ios
  android
  web
  other
}

enum DeviceStatus {
  active
  inactive
  deleted
}

enum NotificationType {
  invitation_created
  invitation_accepted
  membership_removed
  user_created
  user_login
  receipt_submitted
  receipt_approved
  receipt_rejected
  receipt_completed
  receipt_cancelled
  issue_submitted
  issue_approved
  issue_rejected
  issue_completed
  issue_cancelled
}

enum NotificationTargetType {
  tenant_invitation
  tenant_list
  stock_receipt
  stock_issue
  stock_movement
}

enum NotificationOutboxStatus {
  pending
  processing
  published
  failed
  dead_letter
}

model Tenant {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  logoUrl   String?      @map("logo_url")
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  userTenants            UserTenant[]
  userWarehouses         UserWarehouse[]
  invitations            Invitation[]
  warehouses             Warehouse[]
  products               Product[]
  suppliers              Supplier[]
  customers              Customer[]
  departments            Department[]
  numberingCounters      NumberingCounter[]
  openings               StockOpeningBalance[]
  receipts               StockReceipt[]
  issues                 StockIssue[]
  batches                Batch[]
  balances               StockBalance[]
  ledgers                StockLedger[]
  reservations           StockReservation[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  workflows              DocumentWorkflow[]
  workflowSteps          DocumentWorkflowStep[]
  workflowAuthorizations DocumentStepAuthorization[]
  workflowHistories      DocumentStatusHistory[]
  uploadedFiles          UploadedFile[]
  contacts               Contact[]

  @@map("tenants")
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  googleId        String?   @unique @map("google_id")
  passwordHash    String    @map("password_hash")
  name            String?
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  tokenVersion    Int       @default(0) @map("token_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenants         UserTenant[]
  warehouses      UserWarehouse[]
  devices         UserDevice[]
  refreshTokens   RefreshToken[]
  otps            OtpCode[]
  invitationsSent Invitation[]    @relation("InvitationInviter")
  emailLogs       SendEmailLog[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  uploadedFiles   UploadedFile[]

  @@map("users")
}

model UserTenant {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  tenantId  String     @map("tenant_id")
  role      TenantRole @default(staff)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model UserWarehouse {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([tenantId, userId])
  @@map("user_warehouses")
}

model Notification {
  id          String                  @id @default(cuid())
  userId      String                  @map("user_id")
  tenantId    String?                 @map("tenant_id")
  type        NotificationType
  title       String
  body        String
  data        Json?
  eventId     String                  @map("event_id")
  sourceType  String?                 @map("source_type")
  sourceId    String?                 @map("source_id")
  actorUserId String?                 @map("actor_user_id")
  actorName   String?                 @map("actor_name")
  targetType  NotificationTargetType? @map("target_type")
  targetId    String?                 @map("target_id")
  routeName   String?                 @map("route_name")
  routeParams Json?                   @map("route_params")
  deeplink    String?
  readAt      DateTime?               @map("read_at")
  createdAt   DateTime                @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model Contact {
  id           String              @id @default(cuid())
  tenantId     String              @map("tenant_id")
  kind         ContactKind         @default(external)
  relationType ContactRelationType @default(other) @map("relation_type")
  fullName     String              @map("full_name")
  phone        String?
  email        String?
  companyName  String?             @map("company_name")
  taxCode      String?             @map("tax_code")
  note         String?
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant                Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryStepSnapshots DocumentWorkflowStepDeliverySnapshot[]

  @@index([tenantId, relationType])
  @@index([fullName])
  @@index([phone])
  @@map("contacts")
}

model DocumentWorkflowStepDeliverySnapshot {
  id             String   @id @default(cuid())
  workflowStepId String   @unique @map("workflow_step_id")
  contactId      String?  @map("contact_id")
  fullName       String   @map("full_name")
  phone          String?
  email          String?
  companyName    String?  @map("company_name")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  contact      Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  workflowStep DocumentWorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("document_workflow_step_delivery_snapshots")
}

model NotificationOutbox {
  id          String                   @id @default(cuid())
  eventId     String                   @unique @map("event_id")
  tenantId    String                   @map("tenant_id")
  payload     Json
  status      NotificationOutboxStatus @default(pending)
  attempts    Int                      @default(0)
  lastError   String?                  @map("last_error")
  availableAt DateTime                 @default(now()) @map("available_at")
  publishedAt DateTime?                @map("published_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([tenantId, createdAt])
  @@map("notification_outbox")
}

model UserDevice {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  deviceId    String       @unique @map("device_id")
  deviceType  DeviceType   @map("device_type")
  fcmToken    String?      @map("fcm_token")
  deviceModel String?      @map("device_model")
  osVersion   String?      @map("os_version")
  appVersion  String?      @map("app_version")
  deviceInfo  Json?        @map("device_info")
  status      DeviceStatus @default(active)
  lastLoginAt DateTime?    @map("last_login_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([userId, status])
  @@map("user_devices")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  userDeviceId String?   @map("user_device_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userDevice UserDevice? @relation(fields: [userDeviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userDeviceId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  channel    String // email | phone
  codeHash   String    @map("code_hash")
  purpose    String // verify_email | verify_phone
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Invitation {
  id          String     @id @default(cuid())
  tenantId    String     @map("tenant_id")
  email       String
  role        TenantRole @default(staff)
  invitedById String     @map("invited_by_id")
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  declinedAt  DateTime?  @map("declined_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
}

model UploadedFile {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  uploadedById String   @map("uploaded_by_id")
  objectKey    String   @unique @map("object_key")
  url          String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  kind         String   @default("general")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("uploaded_files")
}

model SendEmailLog {
  id           String         @id @default(cuid())
  userId       String?        @map("user_id")
  from         String
  fromName     String?        @map("from_name")
  to           Json
  cc           Json?
  bcc          Json?
  replyTo      String?        @map("reply_to")
  subject      String
  emailType    String         @map("email_type")
  templateName String?        @map("template_name")
  htmlContent  String         @map("html_content")
  status       EmailLogStatus @default(pending)
  error        String?
  metadata     Json?
  sentAt       DateTime?      @map("sent_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("send_email_logs")
}

model NumberingCounter {
  tenantId     String @map("tenant_id")
  docType      String @map("doc_type")
  year         Int
  prefix       String
  currentValue BigInt @default(0) @map("current_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, docType, year])
  @@map("numbering_counters")
}

model Warehouse {
  id                  String        @id @default(cuid())
  tenantId            String        @map("tenant_id")
  code                String
  name                String
  address             String?
  phone               String?
  isActive            Boolean       @default(true) @map("is_active")
  useLocationTracking Boolean       @default(false) @map("use_location_tracking")
  latitude            Decimal?      @db.Decimal(10, 7)
  longitude           Decimal?      @db.Decimal(10, 7)
  geoSource           GeoSource?
  geocodeStatus       GeocodeStatus @default(not_applicable) @map("geocode_status")
  geocodedAt          DateTime?     @map("geocoded_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userWarehouses UserWarehouse[]
  openings       StockOpeningBalance[]
  receipts       StockReceipt[]
  issues         StockIssue[]
  batches        Batch[]
  balances       StockBalance[]
  ledgers        StockLedger[]
  reservations   StockReservation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  taxCode   String?  @map("tax_code")
  contact   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipts StockReceipt[]
  batches  Batch[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issues StockIssue[]

  @@unique([tenantId, code])
  @@map("customers")
}

model Department {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  code               String
  name               String
  parentDepartmentId String?  @map("parent_department_id")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("departments")
}

model Product {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  sku           String
  barcode       String?
  name          String
  imageUrl      String?  @map("image_url")
  baseUnitName  String   @map("base_unit_name")
  minStockLevel Decimal  @default(0) @map("min_stock_level") @db.Decimal(18, 4)
  maxStockLevel Decimal? @map("max_stock_level") @db.Decimal(18, 4)
  reorderPoint  Decimal? @map("reorder_point") @db.Decimal(18, 4)
  averageCost   Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units        ProductUnit[]
  openingLines StockOpeningBalanceDetail[]
  receiptLines StockReceiptDetail[]
  issueLines   StockIssueDetail[]
  batches      Batch[]
  balances     StockBalance[]
  ledgers      StockLedger[]
  reservations StockReservation[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@map("products")
}

model ProductUnit {
  id             String  @id @default(cuid())
  productId      String  @map("product_id")
  unitName       String  @map("unit_name")
  conversionRate Decimal @map("conversion_rate") @db.Decimal(18, 6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitName])
  @@map("product_units")
}

model Batch {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  productId       String    @map("product_id")
  warehouseId     String?   @map("warehouse_id")
  batchNo         String    @map("batch_no")
  manufactureDate DateTime? @map("manufacture_date") @db.Date
  expiryDate      DateTime? @map("expiry_date") @db.Date
  supplierId      String?   @map("supplier_id")
  receiptDetailId String?   @map("receipt_detail_id")
  unitCost        Decimal   @default(0) @map("unit_cost") @db.Decimal(18, 4)
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product                     @relation(fields: [productId], references: [id])
  warehouse      Warehouse?                  @relation(fields: [warehouseId], references: [id])
  supplier       Supplier?                   @relation(fields: [supplierId], references: [id])
  openingDetails StockOpeningBalanceDetail[]

  @@unique([tenantId, productId, batchNo])
  @@index([tenantId, productId, expiryDate])
  @@index([tenantId, warehouseId, expiryDate])
  @@map("batches")
}

model StockOpeningBalance {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  code          String
  effectiveDate DateTime  @map("effective_date") @db.Date
  warehouseId   String    @map("warehouse_id")
  status        DocStatus @default(draft)
  note          String?
  createdById   String    @map("created_by_id")
  approvedById  String?   @map("approved_by_id")
  postedAt      DateTime? @map("posted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(0)

  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse                   @relation(fields: [warehouseId], references: [id])
  details   StockOpeningBalanceDetail[]

  @@unique([tenantId, code])
  @@index([tenantId, warehouseId, status])
  @@index([tenantId, createdAt])
  @@map("stock_opening_balances")
}

model StockOpeningBalanceDetail {
  id               String    @id @default(cuid())
  openingBalanceId String    @map("opening_balance_id")
  productId        String    @map("product_id")
  qtyBaseUnit      Decimal   @map("qty_base_unit") @db.Decimal(18, 4)
  unitCost         Decimal   @map("unit_cost") @db.Decimal(18, 4)
  batchId          String?   @map("batch_id")
  batchNo          String?   @map("batch_no")
  expiryDate       DateTime? @map("expiry_date") @db.Date

  openingBalance StockOpeningBalance @relation(fields: [openingBalanceId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id])
  batch          Batch?              @relation(fields: [batchId], references: [id])

  @@map("stock_opening_balance_details")
}

model StockReceipt {
  id               String      @id @default(cuid())
  tenantId         String      @map("tenant_id")
  code             String
  receiptDate      DateTime    @map("receipt_date") @db.Date
  warehouseId      String      @map("warehouse_id")
  supplierId       String?     @map("supplier_id")
  receiptType      ReceiptType @default(purchase) @map("receipt_type")
  sourceDocType    String?     @map("source_doc_type")
  sourceDocNo      String?     @map("source_doc_no")
  sourceDocDate    DateTime?   @map("source_doc_date") @db.Date
  deliveredByName  String?     @map("delivered_by_name")
  attachedDocsNote String?     @map("attached_docs_note")
  status           DocStatus   @default(draft)
  totalAmount      Decimal     @default(0) @map("total_amount") @db.Decimal(18, 2)
  note             String?
  rejectReason     String?     @map("reject_reason")
  createdById      String      @map("created_by_id")
  approvedById     String?     @map("approved_by_id")
  approvedAt       DateTime?   @map("approved_at")
  completedAt      DateTime?   @map("completed_at")
  clonedFromId     String?     @map("cloned_from_id")
  version          Int         @default(0)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  supplier  Supplier?            @relation(fields: [supplierId], references: [id])
  details   StockReceiptDetail[]

  @@unique([tenantId, code])
  @@index([tenantId, status, warehouseId])
  @@index([tenantId, status, completedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, createdById])
  @@index([tenantId, approvedById])
  @@map("stock_receipts")
}

model StockReceiptDetail {
  id          String    @id @default(cuid())
  receiptId   String    @map("receipt_id")
  productId   String    @map("product_id")
  unitName    String    @map("unit_name")
  expectedQty Decimal   @map("expected_qty") @db.Decimal(18, 4)
  actualQty   Decimal   @map("actual_qty") @db.Decimal(18, 4)
  qtyBaseUnit Decimal   @map("qty_base_unit") @db.Decimal(18, 4)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(18, 4)
  lineAmount  Decimal   @map("line_amount") @db.Decimal(18, 2)
  batchId     String?   @map("batch_id")
  batchNo     String?   @map("batch_no")
  expiryDate  DateTime? @map("expiry_date") @db.Date

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
  @@map("stock_receipt_details")
}

model StockIssue {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  code         String
  issueDate    DateTime  @map("issue_date") @db.Date
  warehouseId  String    @map("warehouse_id")
  issueType    IssueType @map("issue_type")
  customerId   String?   @map("customer_id")
  status       DocStatus @default(draft)
  note         String?
  rejectReason String?   @map("reject_reason")
  createdById  String    @map("created_by_id")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  completedAt  DateTime? @map("completed_at")
  clonedFromId String?   @map("cloned_from_id")
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  customer  Customer?          @relation(fields: [customerId], references: [id])
  details   StockIssueDetail[]

  @@unique([tenantId, code])
  @@index([tenantId, status, warehouseId])
  @@index([tenantId, status, completedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, createdById])
  @@index([tenantId, approvedById])
  @@map("stock_issues")
}

model StockIssueDetail {
  id           String  @id @default(cuid())
  issueId      String  @map("issue_id")
  productId    String  @map("product_id")
  unitName     String  @map("unit_name")
  requestedQty Decimal @map("requested_qty") @db.Decimal(18, 4)
  actualQty    Decimal @map("actual_qty") @db.Decimal(18, 4)
  qtyBaseUnit  Decimal @map("qty_base_unit") @db.Decimal(18, 4)
  unitPrice    Decimal @default(0) @map("unit_price") @db.Decimal(18, 4)
  batchId      String? @map("batch_id")

  issue   StockIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([issueId])
  @@index([productId])
  @@map("stock_issue_details")
}

model StockBalance {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  warehouseId String   @map("warehouse_id")
  batchId     String?  @map("batch_id")
  locationId  String?  @map("location_id")
  onhandQty   Decimal  @default(0) @map("onhand_qty") @db.Decimal(18, 4)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, warehouseId, productId])
  @@map("stock_balances")
}

model StockReservation {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  productId   String            @map("product_id")
  warehouseId String            @map("warehouse_id")
  batchId     String?           @map("batch_id")
  refDocType  String            @map("ref_doc_type")
  refDocId    String            @map("ref_doc_id")
  qtyBaseUnit Decimal           @map("qty_base_unit") @db.Decimal(18, 4)
  status      ReservationStatus @default(active)
  expiresAt   DateTime          @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, productId, warehouseId, status])
  @@index([tenantId, productId, warehouseId, batchId, status])
  @@index([refDocType, refDocId])
  @@index([tenantId, status, expiresAt])
  @@map("stock_reservations")
}

model StockLedger {
  id              String        @id @default(cuid())
  tenantId        String        @map("tenant_id")
  productId       String        @map("product_id")
  warehouseId     String        @map("warehouse_id")
  batchId         String?       @map("batch_id")
  locationId      String?       @map("location_id")
  transactionType LedgerTxnType @map("transaction_type")
  refDocType      String        @map("ref_doc_type")
  refDocId        String        @map("ref_doc_id")
  qtyChange       Decimal       @map("qty_change") @db.Decimal(18, 4)
  qtyBalanceAfter Decimal       @map("qty_balance_after") @db.Decimal(18, 4)
  unitCost        Decimal       @default(0) @map("unit_cost") @db.Decimal(18, 4)
  note            String?
  createdById     String        @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, productId, warehouseId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([refDocType, refDocId])
  @@map("stock_ledgers")
}

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String?     @map("tenant_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  entityCode String?     @map("entity_code")
  changes    Json?
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model DocumentWorkflow {
  id                   String                 @id @default(cuid())
  tenantId             String                 @map("tenant_id")
  documentType         DocumentType           @map("document_type")
  documentId           String                 @map("document_id")
  status               WorkflowDocumentStatus @default(draft)
  currentStepCode      String?                @map("current_step_code")
  currentStepStatus    WorkflowStepStatus?    @map("current_step_status")
  currentStepUpdatedAt DateTime?              @map("current_step_updated_at")
  lastActionById       String?                @map("last_action_by_id")
  lastActionAt         DateTime?              @map("last_action_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  version              Int                    @default(0)

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps          DocumentWorkflowStep[]
  authorizations DocumentStepAuthorization[]
  histories      DocumentStatusHistory[]

  @@unique([documentType, documentId])
  @@index([tenantId, documentType, status])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, lastActionById])
  @@map("document_workflows")
}

model DocumentWorkflowStep {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  workflowId         String             @map("workflow_id")
  documentType       DocumentType       @map("document_type")
  documentId         String             @map("document_id")
  stepCode           String             @map("step_code")
  stepName           String             @map("step_name")
  sequence           Int
  requiredRole       TenantRole?        @map("required_role")
  requiredSignerId   String?            @map("required_signer_id")
  assignedApproverId String?            @map("assigned_approver_id")
  actualSignerId     String?            @map("actual_signer_id")
  authorizedSignerId String?            @map("authorized_signer_id")
  status             WorkflowStepStatus @default(pending)
  note               String?
  actionAt           DateTime?          @map("action_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  version            Int                @default(0)

  tenant                               Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow                             DocumentWorkflow                      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  authorizations                       DocumentStepAuthorization[]
  documentWorkflowStepDeliverySnapshot DocumentWorkflowStepDeliverySnapshot?

  @@unique([workflowId, stepCode])
  @@index([tenantId, workflowId, sequence])
  @@index([tenantId, assignedApproverId, status])
  @@index([tenantId, requiredSignerId, status])
  @@index([tenantId, documentType, status])
  @@map("document_workflow_steps")
}

model DocumentStepAuthorization {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  workflowId      String    @map("workflow_id")
  stepId          String    @map("step_id")
  documentId      String    @map("document_id")
  uploadedById    String    @map("uploaded_by_id")
  fileId          String?   @map("file_id")
  fileUrl         String?   @map("file_url")
  fileName        String?   @map("file_name")
  authorizationNo String?   @map("authorization_no")
  issuedBy        String?   @map("issued_by")
  issuedAt        DateTime? @map("issued_at")
  validFrom       DateTime? @map("valid_from")
  validTo         DateTime? @map("valid_to")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step     DocumentWorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  workflow DocumentWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, stepId])
  @@index([tenantId, workflowId])
  @@index([tenantId, documentId])
  @@map("document_step_authorizations")
}

model DocumentStatusHistory {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  workflowId    String?      @map("workflow_id")
  documentType  DocumentType @map("document_type")
  documentId    String       @map("document_id")
  stepId        String?      @map("step_id")
  fromStatus    String       @map("from_status")
  toStatus      String       @map("to_status")
  changedById   String       @map("changed_by_id")
  changedByRole String?      @map("changed_by_role")
  note          String?
  metadata      Json?
  changedAt     DateTime     @default(now()) @map("changed_at")

  tenant   Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow DocumentWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId, changedAt])
  @@index([tenantId, workflowId, changedAt])
  @@index([tenantId, stepId, changedAt])
  @@index([tenantId, documentType, changedAt])
  @@map("document_status_history")
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  key            String
  scope          String // actor scope: userId | tenantId | ip để tránh key trùng giữa các actor
  method         String
  path           String
  requestHash    String // sha256(method + path + sorted body)
  status         IdempotencyStatus @default(in_progress)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_records")
}
