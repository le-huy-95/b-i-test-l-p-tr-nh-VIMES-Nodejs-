# Server
PORT=3004
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/inventory_db?schema=public

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6380

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=inventory
MINIO_USE_SSL=false

# Public URL (deep link verify / invite)
APP_PUBLIC_URL=http://localhost:3004

# Email — port từ ktx-be-new (điền SMTP_USER / SMTP_PASS local, không commit secret)
DEFAULT_FROM_ADDRESS=lexuanhuy8695@gmail.com
DEFAULT_FROM_NAME=Vimes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lexuanhuy8695@gmail.com
SMTP_PASS=ojyu myxo kfjb pymb

# OTP
OTP_EXPIRES_MINUTES=15
INVITE_EXPIRES_HOURS=72

# Firebase (Google Sign-In — port từ ktx-be-new)
# App Flutter (test-y-te-flutter) dùng project "vimesproject-ccd28" nên
# FIREBASE_PROJECT_ID phải trùng project của client để verifyIdToken chạy đúng.
# LƯU Ý: file service account ktx-dev-*.json hiện tại thuộc project "ktx-dev" —
# nên thay bằng service account của project "vimesproject-ccd28" cho an toàn.
# Backend có fallback verify qua Google tokeninfo nên vẫn login được khi token
# là Google ID token (không phụ thuộc Firebase project).
FIREBASE_PROJECT_ID=vimesproject-ccd28
FIREBASE_SERVICE_ACCOUNT_PATH=src/config/firebase/ktx-dev-1bd5214b83b2.json

# Facebook webhook (Meta GET hub.challenge — khớp Verify Token trên dashboard)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=dev_facebook_verify_token

# Kafka (notification events)
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=inventory-api
KAFKA_TOPIC_NOTIFICATIONS=tenant-notification-events
KAFKA_ENABLED=false

# Notification WS service
NOTIFICATION_WS_PORT=3001
